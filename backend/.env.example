PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sapatos_ecommerce
DB_USER=postgres
DB_PASSWORD=your_password

# JWT (OBRIGATÓRIO — o servidor NÃO inicia sem JWT_SECRET)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# CORS
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000

# OpenAPI Spec URL (usado pelo API Contract Tester)
OPENAPI_SPEC_URL=http://localhost:5000/api/openapi.json

# AWS S3 (opcional para imagens)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
AWS_BUCKET_NAME=sapatos-ecommerce
