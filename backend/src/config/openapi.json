{
  "openapi": "3.0.3",
  "info": {
    "title": "ATALAIA Shoes API",
    "description": "API Backend para o e-commerce de sapatos femininos de luxo ATALAIA",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Verifica a integridade do servidor",
        "responses": {
          "200": {
            "description": "Servidor está online",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cadastra um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "email", "senha"],
                "properties": {
                  "nome": { "type": "string", "example": "Maria Silva" },
                  "email": { "type": "string", "format": "email", "example": "maria@exemplo.com" },
                  "senha": { "type": "string", "example": "senha123" },
                  "telefone": { "type": "string", "example": "11999999999" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "nome": { "type": "string" },
                        "email": { "type": "string" },
                        "is_admin": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Usuário já existe ou dados ausentes"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica um usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "maria@exemplo.com" },
                  "senha": { "type": "string", "example": "senha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "nome": { "type": "string" },
                        "email": { "type": "string" },
                        "is_admin": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/api/auth/reset/request": {
      "post": {
        "tags": ["Auth"],
        "summary": "Solicita redefinição de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "maria@exemplo.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instruções de redefinição de senha enviadas"
          }
        }
      }
    },
    "/api/auth/reset/confirm": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirma redefinição de senha usando token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "novaSenha"],
                "properties": {
                  "token": { "type": "string" },
                  "novaSenha": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha redefinida com sucesso"
          },
          "400": {
            "description": "Token inválido ou expirado"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Lista todos os produtos ativos com filtros",
        "parameters": [
          { "name": "categoria", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "preco_min", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "preco_max", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "busca", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["nome", "preco", "data_criacao", "estoque"] } },
          { "name": "order", "in": "query", "required": false, "schema": { "type": "string", "enum": ["asc", "desc"] } }
        ],
        "responses": {
          "200": {
            "description": "Lista de produtos filtrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Cria um novo produto (apenas Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "preco"],
                "properties": {
                  "nome": { "type": "string" },
                  "descricao": { "type": "string" },
                  "categoria": { "type": "string" },
                  "preco": { "type": "number" },
                  "tamanhos": { "type": "string" },
                  "cores": { "type": "string" },
                  "imagem": { "type": "string" },
                  "estoque": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "description": "Acesso não autorizado"
          }
        }
      }
    },
    "/api/products/highlights": {
      "get": {
        "tags": ["Products"],
        "summary": "Lista produtos em destaque",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 8 } }
        ],
        "responses": {
          "200": {
            "description": "Produtos em destaque",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "itens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "quantidade": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Obtém detalhes de um produto específico",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do produto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Produto não encontrado"
          }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Retorna os itens do carrinho do usuário atual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de itens no carrinho"
          }
        }
      },
      "post": {
        "tags": ["Cart"],
        "summary": "Adiciona um item ao carrinho",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["produto_id", "quantidade"],
                "properties": {
                  "produto_id": { "type": "string", "format": "uuid" },
                  "quantidade": { "type": "integer", "minimum": 1 },
                  "tamanho": { "type": "string" },
                  "cor": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item adicionado com sucesso"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Lista os pedidos do usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pedidos"
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Cria um novo pedido",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["endereco", "cidade", "estado", "cep", "metodo_pagamento"],
                "properties": {
                  "endereco": { "type": "string" },
                  "cidade": { "type": "string" },
                  "estado": { "type": "string" },
                  "cep": { "type": "string" },
                  "metodo_pagamento": { "type": "string" },
                  "cupom": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado com sucesso"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "categoria": { "type": "string" },
          "preco": { "type": "number" },
          "tamanhos": { "type": "string" },
          "cores": { "type": "string" },
          "imagem": { "type": "string" },
          "estoque": { "type": "integer" },
          "ativo": { "type": "boolean" },
          "data_criacao": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
